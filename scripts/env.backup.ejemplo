# Copiá este archivo como .env.backup (en la raíz del proyecto) y completalo. .env.backup NO se sube al repo.
# Nunca pegues estas claves en un chat.

# Supabase > botón Connect > "Session pooler" > URI. Reemplazá [YOUR-PASSWORD] por la contraseña de la base.
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-xx.pooler.supabase.com:5432/postgres

# Solo para bajar las fotos (si no los ponés, se baja solo la base).
# Supabase > Project Settings > API Keys > Secret key.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=

# Opcional: dónde guardar y cuántos backups de la base conservar.
# Mejor en una nube PERSONAL sincronizada (nunca la del trabajo), por ejemplo Google Drive para escritorio:
# BACKUP_CARPETA=G:/Mi unidad/lomada-backups
# BACKUP_GUARDAR=8
