# Copiar a .env.local para desarrollo local. Nunca subir .env.local a GitHub.

# Front (Vite): URL y clave publicable del proyecto de Supabase personal
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Funciones de /api (van en Vercel, nunca en el front)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Opcional y gratis (api.data.gov/signup). Sin clave se usa DEMO_KEY, con un límite bajo por hora.
USDA_API_KEY=

# Notificaciones (opcional). Generar el par una vez con: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# WHOOP (opcional). Las tres últimas van solo en Vercel.
APP_URL=
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Clave secreta de Supabase. Nunca en el front ni con prefijo VITE_.
SUPABASE_SECRET_KEY=
